# Database Connection (Update with your local PostgreSQL or MySQL connection string)
# Example for PostgreSQL: postgresql://user:password@localhost:5432/civicbank?schema=public
# Example for MySQL (XAMPP/Local): mysql://root:@localhost:3306/civicbank
DATABASE_URL="mysql://root:@localhost:3306/civicbank"

# NextAuth Secret (Generate a secure random string using `openssl rand -base64 32` or any secure generator)
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# NextAuth URL (Set to your local development URL)
NEXTAUTH_URL="http://localhost:3000"